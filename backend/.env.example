# Aplicación
APP_NAME=Radar de Credenciales Comprometidas
APP_ENV=dev
APP_VERSION=1.0.0
TIMEZONE=America/Lima
API_V1_PREFIX=/api/v1

# REQUERIDAS: generar valores propios; nunca reutilizar estos placeholders
DATABASE_URL=postgresql+psycopg://radar:<CONFIGURE_POSTGRES_PASSWORD>@localhost:55433/radar_creds
JWT_SECRET=<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS>
JWT_ALGORITHM=HS256
HIBP_API_KEY=<CONFIGURE_HIBP_API_KEY>

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=true

# API / seguridad
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_CHALLENGE_EXPIRE_MINUTES=5
MFA_REQUIRED_ROLES=["admin","soc_analyst"]
PASSWORD_MIN_LENGTH=12
N8N_SERVICE_TOKEN=<CONFIGURE_N8N_SERVICE_TOKEN>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
BACKEND_SCHEDULER_COLLECT_ENABLED=false

# HIBP
HIBP_BASE_URL=https://haveibeenpwned.com/api/v3
HIBP_USER_AGENT=RadarCreds/1.0
HIBP_RATE_LIMIT_SECONDS=1.6
HIBP_MAX_RETRIES=3
HIBP_BACKOFF_BASE=2.0
HIBP_CACHE_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=60

# IdP (OPCIONALES según IDP_PROVIDER)
IDP_PROVIDER=generic_webhook
IDP_TENANT_ID=<CONFIGURE_IDP_TENANT_ID>
IDP_CLIENT_ID=<CONFIGURE_IDP_CLIENT_ID>
IDP_CLIENT_SECRET=<CONFIGURE_IDP_CLIENT_SECRET>
IDP_WEBHOOK_URL=http://host.docker.internal:9000/idp
IDP_WEBHOOK_HMAC_SECRET=<CONFIGURE_IDP_HMAC_SECRET>
LDAP_SERVER=<CONFIGURE_LDAP_SERVER>
LDAP_BASE_DN=<CONFIGURE_LDAP_BASE_DN>
LDAP_BIND_DN=<CONFIGURE_LDAP_BIND_DN>
LDAP_BIND_PASSWORD=<CONFIGURE_LDAP_BIND_PASSWORD>

# SMTP / chat (OPCIONALES)
SMTP_HOST=<CONFIGURE_SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<CONFIGURE_SMTP_USER>
SMTP_PASSWORD=<CONFIGURE_SMTP_PASSWORD>
SMTP_FROM=radar-creds@example.com
SMTP_USE_TLS=true
TEAMS_WEBHOOK_URL=<CONFIGURE_TEAMS_WEBHOOK_URL>
SLACK_WEBHOOK_URL=<CONFIGURE_SLACK_WEBHOOK_URL>

# Reportes / auditoría / observabilidad
REPORTS_STORAGE_PATH=/var/lib/radar_creds/reports
REPORTS_SIGNED_URL_TTL_SECONDS=86400
RETRY_BACKOFF_SCHEDULE_MIN=[15,30,60,240,1440]
RETRY_MAX_ATTEMPTS=5
AUDIT_RETENTION_DAYS=365
AUDIT_VERIFY_INTERVAL_HOURS=6
METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=true

# Usadas por backend/docker-compose.yml
POSTGRES_PASSWORD=<CONFIGURE_POSTGRES_PASSWORD>
N8N_USER=<CONFIGURE_N8N_USER>
N8N_PASSWORD=<CONFIGURE_N8N_PASSWORD>
