      "position": [460, 420],
      "credentials": { "httpHeaderAuth": { "id": "radar_http_hibp", "name": "HIBP API" } }
    },
    {
      "parameters": {
        "jsCode": "const event = $('Input').first().json;\nconst users = $('Leer Usuarios Activos').all().map(item => item.json);\nconst catalogItems = $('HIBP Breaches Catalog').all();\nconst catalog = catalogItems.flatMap(item => {\n  const value = item.json;\n  if (Array.isArray(value)) return value;\n  if (Array.isArray(value.body)) return value.body;\n  if (typeof value.body === 'string') { try { return JSON.parse(value.body); } catch { return []; } }\n  if (Array.isArray(value.data)) return value.data;\n  return value.Name ? [value] : [];\n});\nconst email = String(event.email || '').trim().toLowerCase();\nconst breach = String(event.breach || '').trim();\nconst user = users.find(item => String(item.email || '').trim().toLowerCase() === email);\nconst metadata = catalog.find(item => String(item.Name || '').trim() === breach);\nif (!user || !metadata) return [];\nconst dataClasses = Array.isArray(metadata.DataClasses) ? metadata.DataClasses : [];\nlet severidad = 'baja';\nif (dataClasses.some(value => /password/i.test(String(value)))) severidad = 'critica';\nelse if (dataClasses.some(value => /credit|bank|token/i.test(String(value)))) severidad = 'alta';\nelse if (dataClasses.some(value => /email|username|phone/i.test(String(value)))) severidad = 'media';\nreturn [{ json: { email_corporativo: email, usuario_id: user.usuario_id ?? user.id, breach_origen: breach, breach_dominio: metadata.Domain || null, fecha_breach: metadata.BreachDate || null, severidad, datos_expuestos: dataClasses, fuente_detalle: 'HIBP/' + breach } }];"
      },
      "id": "a0200000-0000-0000-0000-000000000004",
