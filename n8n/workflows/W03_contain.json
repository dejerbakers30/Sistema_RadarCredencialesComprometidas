    "Revoke Sessions": { "main": [[{ "node": "Sync IdP Responses", "type": "main", "index": 1 }], []] },
    "Sync IdP Responses": { "main": [[{ "node": "Evaluate Result", "type": "main", "index": 0 }]] },
