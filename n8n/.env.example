# Runtime n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Lima

# Referencias consumidas por los workflows
RADAR_API_BASE=http://host.docker.internal:8000/api/v1
RADAR_SERVICE_TOKEN=<CONFIGURE_N8N_SERVICE_TOKEN>
ADMIN_EMAIL=admin@example.com
IDP_WEBHOOK_URL=http://host.docker.internal:9000/idp
IDP_HMAC_SECRET=<CONFIGURE_IDP_HMAC_SECRET>
IDP_BEARER_TOKEN=<CONFIGURE_IDP_BEARER_TOKEN>
IDP_USERS_ENDPOINT=http://host.docker.internal:9000/idp/users
TEAMS_WEBHOOK=http://host.docker.internal:9000/teams
